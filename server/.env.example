# Bu dosyayı .env olarak kopyalayıp doldurun. .env git'e GİRMEZ (.gitignore).
#
# APP_TOKEN: LAN erişim anahtarı. Boş bırakılırsa /api/* korumasız olur
# (yalnızca tek makinede, localhost'ta geliştirme için uygundur).
# Ofis/LAN paylaşımında mutlaka doldurun — panel ilk açılışta bir kez sorar,
# tarayıcıda saklar ve her istekte X-TSS-Token header'ı ile gönderir.
APP_TOKEN=

# Sunucunun dinleyeceği port
PORT=3000

# 0.0.0.0 = LAN'daki diğer cihazlar da erişebilir.
# Sadece bu makineden erişilsin isterseniz: 127.0.0.1
HOST=0.0.0.0

# Veritabanı dosyasının yolu (varsayılan: server/data/tss.db)
# TSS_DB_PATH=
